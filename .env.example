# --- Direct SAML sign-in (the agency's own web app) ---
export issuer=urn:gov:gsa:SAML:2.0.profiles:sp:sso:benefits_agency
export assertion_consumer_service_url=http://localhost:4567/consume
export idp_sso_target_url=http://localhost:3000/api/saml/auth2026
export idp_slo_target_url=http://localhost:3000/api/saml/logout2026
export idp_cert_fingerprint=39:22:D5:3D:F1:2D:8A:12:2C:AA:99:AB:28:78:07:2C:A3:1B:5C:E4

# --- Delegated-access resource server (GET /api/benefits) ---
# One delegation scope per application; this application is registered
# read-only, so the API has no write route. Assertions are key-bound (DPoP)
# whenever the service provider is a public client; nothing here turns that
# on or off.
export idp_url=http://localhost:3000
export SAML_METADATA_YEAR=2026
# export IDP_METADATA_URL=http://localhost:3000/api/saml/metadata2026
export RESOURCE_IDENTIFIER=https://benefits-api.agency.localdev
export DELEGATION_SCOPE=token_exchange:retirement_benefits
export RS_PRIVATE_KEY_PATH=./config/demo_sp.key
export ALLOWED_CLOCK_DRIFT=60
export REPLAY_PROTECTION=true

