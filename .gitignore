.DS_store

/.idea
*.gem
*.rbc
/.config
/coverage/
/log/*.log
/InstalledFiles
/pkg/
/spec/reports/
/spec/examples.txt
/test/tmp/
/test/version_tmp/
/tmp/

## Specific to RubyMotion:
.dat*
.repl_history
build/

## Documentation cache and generated files:
/.yardoc/
/_yardoc/
/doc/
/rdoc/

## Environment normalization:
/.bundle/
/vendor/bundle
/lib/bundler/man/

.env

# for a library or gem, you might want to ignore these files since the code is
# intended to run in multiple environments; otherwise, check them in:
# Gemfile.lock
# .ruby-version
# .ruby-gemset

# unless supporting rvm < 1.11.0 or doing something fancy, ignore this:
.rvmrc

.byebug_history

public/api/deploy.json
public/vendor
node_modules

# Never commit certificates or private keys created for this app; generate or
# copy them in a setup step. The upstream sample app's demo key pair predates
# this rule and stays tracked.
config/*.key
config/*.crt
config/*.pem
!config/demo_sp.key
!config/demo_sp.crt
