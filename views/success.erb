<div class="clearfix">
  <div class="col-12 sm-col-6 mx-auto">
    <div class="h5 p2 bg-green white center">
      <span class="bold caps">Success!</span>
      <span>Your email is <strong><%= session[:email] %></strong>.</span>
      <% if session[:third_party_initiated_hint] %>
      <%# Third-Party-Initiated Login (OpenID Connect Core 1.0 §4): the sign-in was started by a
          third party. Only the opaque hint it sent is shown; the identity above came from the
          SAML assertion, never from the hint. %>
      <span class="block">This sign-in was started by a third party (third-party-initiated login,
        hint <code><%= Rack::Utils.escape_html(session[:third_party_initiated_hint]) %></code>).</span>
      <% end %>
      <% if session[:userid] %>
      <form action="/logout" method="POST">
        <button type="submit" class="btn btn-outline bg-white navy">Logout</button>
      </form>
      <% end %>
    </div>
  </div>
</div>

<div class="clearfix py3 mxn1">
  <% (0..7).each do |i| %>
    <div class="sm-col sm-col-6 px1">
      <div class="p2 mb2 bg-white rounded">
        <div class="p1 mb1 bg-darken-1 col-7"></div>
        <div class="p1 mb1 bg-darken-1 col-10"></div>
        <div class="p1 mb1 bg-darken-1 col-5"></div>
        <div class="p1 mb1 bg-darken-1 col-8"></div>
        <div class="p1 mb1 bg-darken-1 col-6"></div>
        <div class="p1 mb1 bg-darken-1 col-11"></div>
        <div class="p1 mb1 bg-darken-1 col-8"></div>
      </div>
    </div>
  <% end %>
</div>
