<p>
  Each delegated session is one <code>delegation_id</code>: the Attempts events Login.gov sent for
  it (consent, token issuance, refresh, revocation, and the sign-in events re-mapped to this
  agency) followed by the calls this API authorized or refused for assertions carrying the same
  <code>delegation_id</code>. This is the join described in §8.5.
</p>
<% if sessions.empty? %>
  <p>No delegated sessions in the current events.</p>
<% end %>
<% sessions.each do |delegation_id, session_info| %>
  <section class="usa-summary-box margin-bottom-4" aria-labelledby="delegation-<%= h delegation_id %>">
    <div class="usa-summary-box__body">
      <h2 class="usa-summary-box__heading" id="delegation-<%= h delegation_id %>">
        delegation_id <code><%= h delegation_id %></code>
        <% if session_info[:revoked] %><span class="usa-tag bg-secondary">revoked</span><% end %>
      </h2>
      <div class="usa-summary-box__text">
        <ul class="usa-list usa-list--unstyled">
          <li><strong>Acting service provider:</strong> <code><%= h session_info[:actor_issuer] %></code></li>
          <li><strong>Resources:</strong> <%= h Array(session_info[:resources]).join(' ') %></li>
          <li><strong>Approved scopes:</strong> <%= h Array(session_info[:scopes]).join(' ') %></li>
          <li><strong>Remembered:</strong> <%= h session_info[:remembered].inspect %></li>
        </ul>

        <h3>Attempts events</h3>
        <table class="usa-table usa-table--compact">
          <thead>
            <tr><th scope="col">Occurred at</th><th scope="col">Type</th><th scope="col">subject.session_id</th><th scope="col">Details</th></tr>
          </thead>
          <tbody>
            <% session_info[:events].each do |e| %>
              <% payload = event_payload(e) %>
              <tr>
                <td><%= Time.at(payload['occurred_at'].to_f).utc.iso8601 %></td>
                <td><%= h event_type(e) %></td>
                <td class="font-mono-2xs"><%= h payload.dig('subject', 'session_id') %></td>
                <td class="font-mono-2xs">
                  <%= h event_data(payload).except('subject', 'occurred_at', 'delegation_id').map { |k, v| "#{k}=#{v.is_a?(Array) ? v.join(' ') : v}" }.join('; ') %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <h3>API decisions with this delegation_id</h3>
        <% if session_info[:decisions].empty? %>
          <p>None yet.</p>
        <% else %>
          <table class="usa-table usa-table--compact">
            <thead>
              <tr><th scope="col">Time</th><th scope="col">Route</th><th scope="col">Decision</th><th scope="col">Required scope</th><th scope="col">Actor</th><th scope="col">Assertion ID</th></tr>
            </thead>
            <tbody>
              <% session_info[:decisions].each do |d| %>
                <tr>
                  <td><%= d.time.utc.iso8601 %></td>
                  <td><code><%= h d.route %></code></td>
                  <td><%= h d.decision %><% if d.reason %> (<%= h d.reason %>)<% end %></td>
                  <td><code><%= h d.required_scope %></code></td>
                  <td><%= h d.actor %></td>
                  <td class="font-mono-2xs"><%= h d.assertion_id %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
